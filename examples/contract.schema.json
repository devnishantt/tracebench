{
  "$defs": {
    "ColumnSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "uuid",
            "email"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "min_length": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "pattern": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "allowed": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed"
        },
        "max_null_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Null Fraction"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge"
          ],
          "title": "Op",
          "type": "string"
        },
        "right": {
          "title": "Right",
          "type": "string"
        },
        "ignore_nulls": {
          "default": true,
          "title": "Ignore Nulls",
          "type": "boolean"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "left",
        "op",
        "right"
      ],
      "title": "Relation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnSpec"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Columns",
      "type": "array"
    },
    "min_rows": {
      "default": 1,
      "maximum": 1000000,
      "minimum": 0,
      "title": "Min Rows",
      "type": "integer"
    },
    "max_rows": {
      "anyOf": [
        {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Rows"
    },
    "extra_columns": {
      "default": "forbid",
      "enum": [
        "allow",
        "warn",
        "forbid"
      ],
      "title": "Extra Columns",
      "type": "string"
    },
    "primary_key": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Primary Key",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "maxItems": 50,
      "title": "Relations",
      "type": "array"
    },
    "null_tokens": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Null Tokens",
      "type": "array"
    },
    "sample_limit": {
      "default": 5,
      "maximum": 20,
      "minimum": 0,
      "title": "Sample Limit",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "columns"
  ],
  "title": "DatasetSpec",
  "type": "object"
}
